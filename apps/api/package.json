{
  "name": "@cycloneshield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "lint": "eslint src test",
    "test": "vitest run",
    "smoke:open-meteo": "tsx src/providers/open-meteo-smoke.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx ../../scripts/seed.ts"
  },
  "dependencies": {
    "@cycloneshield/shared": "0.1.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3"
  }
}
